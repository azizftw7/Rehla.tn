# Copier ce fichier en .env (jamais commité) puis compléter les valeurs.

# Port de l'API (le front appelle http://localhost:5000/api)
PORT=5000

# MongoDB en local :
#   MONGODB_URI=mongodb://127.0.0.1:27017/rehla
# MongoDB Atlas (copier la chaîne de connexion depuis Atlas > Connect > Drivers) :
#   MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/rehla?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/rehla

# Secret de signature des tokens : une longue chaîne aléatoire, différente pour chaque environnement.
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origine autorisée par CORS (URL du front Vite). Plusieurs origines : séparer par des virgules.
CLIENT_URL=http://localhost:5173

# Mot de passe commun des comptes de démo créés par « npm run seed » (développement uniquement, 8 caractères minimum).
SEED_DEMO_PASSWORD=
